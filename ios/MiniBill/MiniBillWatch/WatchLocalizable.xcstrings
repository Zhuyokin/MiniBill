    "Saved on Apple Watch. Sync resumes when iPhone is available.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Apple Watch gespeichert. Die Synchronisierung wird fortgesetzt, sobald das iPhone verfügbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved on Apple Watch. Sync resumes when iPhone is available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch に保存済みです。iPhone に接続できると同期を再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch에 저장했습니다. iPhone에 연결되면 동기화가 재개됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存在 Apple Watch 上。iPhone 可连接时会继续同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存在 Apple Watch 上。iPhone 可連線時會繼續同步。"
          }
        }
      }
    },
