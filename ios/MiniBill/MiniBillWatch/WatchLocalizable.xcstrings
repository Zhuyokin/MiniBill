        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 동기화 후 계정과 내역이 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次同步后，账户和账单会显示在这里。"
