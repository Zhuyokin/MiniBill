    "Your accounts and entries will appear here after the first sync.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der ersten Synchronisierung erscheinen hier deine Konten und Einträge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your accounts and entries will appear here after the first sync."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回の同期後に口座と明細が表示されます。"
