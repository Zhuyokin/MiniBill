{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld entries" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"%lld件"}},"ko":{"stringUnit":{"state":"translated","value":"%lld건"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%lld 笔"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%lld 筆"}}}},
    "About MiniBill" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"MiniBillについて"}},"ko":{"stringUnit":{"state":"translated","value":"MiniBill 정보"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关于 MiniBill"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"關於 MiniBill"}}}},
    "Add Entry" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"記録を追加"}},"ko":{"stringUnit":{"state":"translated","value":"내역 추가"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记一笔"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"記一筆"}}}},
    "Amount" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"金額"}},"ko":{"stringUnit":{"state":"translated","value":"금액"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"金额"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"金額"}}}},
    "Amount cannot exceed ¥99,999,999.99." : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"1件の金額は¥99,999,999.99以下にしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"한 건의 금액은 ¥99,999,999.99를 초과할 수 없습니다."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"单笔金额不能超过 ¥99,999,999.99。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"單筆金額不能超過 ¥99,999,999.99。"}}}},
    "App" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"アプリ"}},"ko":{"stringUnit":{"state":"translated","value":"앱"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"App"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"App"}}}},
    "Backup" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"バックアップ"}},"ko":{"stringUnit":{"state":"translated","value":"백업"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备份"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"備份"}}}},
    "Backup Entries" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"バックアップ件数"}},"ko":{"stringUnit":{"state":"translated","value":"백업 내역"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备份记录数"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"備份記錄數"}}}},
    "Backups are not encrypted. Save them only in a location you trust." : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"バックアップは暗号化されません。信頼できる場所に保存してください。"}},"ko":{"stringUnit":{"state":"translated","value":"백업은 암호화되지 않습니다. 신뢰할 수 있는 위치에만 저장하세요."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备份文件未加密，请仅保存到可信位置。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"備份檔案未加密，請只儲存在可信任的位置。"}}}},
    "Bills" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"帳簿"}},"ko":{"stringUnit":{"state":"translated","value":"장부"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账单"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"帳單"}}}},
    "Cancel" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"キャンセル"}},"ko":{"stringUnit":{"state":"translated","value":"취소"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"取消"}}}},
    "Close" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"閉じる"}},"ko":{"stringUnit":{"state":"translated","value":"닫기"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关闭"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"關閉"}}}},
    "Could not delete entry" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"記録を削除できませんでした"}},"ko":{"stringUnit":{"state":"translated","value":"내역을 삭제하지 못했습니다"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法删除流水"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法刪除流水"}}}},
    "Could not prepare this entry for sharing." : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"この記録を共有用に準備できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"이 내역을 공유할 수 있도록 준비하지 못했습니다."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法准备这笔流水的分享内容。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法準備這筆流水的分享內容。"}}}},
    "Could not schedule the reminder. Your preference was saved; try again." : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"リマインダーを予約できませんでした。設定は保存されています。もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"알림을 예약하지 못했습니다. 설정은 저장되었습니다. 다시 시도하세요."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提醒排程失败，偏好已保存，请重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"提醒排程失敗，偏好已儲存，請再試一次。"}}}},
    "Could not save. Your changes are still here; try again." : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"保存できませんでした。変更は保持されています。もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"저장하지 못했습니다. 변경 내용은 유지됩니다. 다시 시도하세요."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法保存，修改内容仍保留，请重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法儲存，修改內容仍保留，請再試一次。"}}}},
    "Could not save. Your input is still here; try again." : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"保存できませんでした。入力内容は保持されています。もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"저장하지 못했습니다. 입력 내용은 유지됩니다. 다시 시도하세요."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法保存，输入内容仍保留，请重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法儲存，輸入內容仍保留，請再試一次。"}}}},
    "Current Entries" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"現在の件数"}},"ko":{"stringUnit":{"state":"translated","value":"현재 내역"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机记录数"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機記錄數"}}}},
    "Current Ledger" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"現在の帳簿"}},"ko":{"stringUnit":{"state":"translated","value":"현재 장부"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前账本"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前帳本"}}}},
    "Daily bookkeeping reminder" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"毎日の記帳リマインダー"}},"ko":{"stringUnit":{"state":"translated","value":"매일 장부 기록 알림"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每日记账提醒"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每日記帳提醒"}}}},
    "Daily Net" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"日別純利益"}},"ko":{"stringUnit":{"state":"translated","value":"일별 순이익"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每日净收益"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每日淨收益"}}}},
    "Daily Reminder" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"毎日のリマインダー"}},"ko":{"stringUnit":{"state":"translated","value":"매일 알림"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每日记账提醒"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每日記帳提醒"}}}},
    "Daily Time" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"毎日の時刻"}},"ko":{"stringUnit":{"state":"translated","value":"매일 시간"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每日时间"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每日時間"}}}},
    "Date" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"日付"}},"ko":{"stringUnit":{"state":"translated","value":"날짜"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"日期"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"日期"}}}},
    "Date Range" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"日付範囲"}},"ko":{"stringUnit":{"state":"translated","value":"날짜 범위"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"日期范围"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"日期範圍"}}}},
    "Delete" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"削除"}},"ko":{"stringUnit":{"state":"translated","value":"삭제"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"刪除"}}}},
    "Delete Entry" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"記録を削除"}},"ko":{"stringUnit":{"state":"translated","value":"내역 삭제"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除流水"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"刪除流水"}}}},
    "Delete failed. The entry was not changed." : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"削除できませんでした。記録は変更されていません。"}},"ko":{"stringUnit":{"state":"translated","value":"삭제하지 못했습니다. 내역은 변경되지 않았습니다."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除失败，流水未发生改变。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"刪除失敗，流水未有變更。"}}}},
    "Delete this entry?" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"この記録を削除しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"이 내역을 삭제할까요?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除这笔流水？"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"刪除這筆流水？"}}}},
    "Deleting it also updates statistics." : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"削除すると統計も更新されます。"}},"ko":{"stringUnit":{"state":"translated","value":"삭제하면 통계도 함께 업데이트됩니다."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除后统计会同步变化。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"刪除後統計會同步更新。"}}}},
    "Discard" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"破棄"}},"ko":{"stringUnit":{"state":"translated","value":"버리기"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"放弃"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"放棄"}}}},
    "Discard this entry?" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"この入力を破棄しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"이 입력을 버릴까요?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"放弃这笔流水？"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"放棄這筆流水？"}}}},
    "Discard your changes?" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"変更を破棄しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"변경 내용을 버릴까요?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"放弃修改？"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"放棄修改？"}}}},
    "Enter an amount greater than zero with at most two decimal places." : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"0より大きく、小数点以下2桁以内の金額を入力してください。"}},"ko":{"stringUnit":{"state":"translated","value":"0보다 크고 소수점 이하 두 자리 이내의 금액을 입력하세요."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入大于零且最多两位小数的金额。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請輸入大於零且最多兩位小數的金額。"}}}},
    "Entries" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"件数"}},"ko":{"stringUnit":{"state":"translated","value":"건수"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"笔数"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"筆數"}}}},
    "Entry Details" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"記録の詳細"}},"ko":{"stringUnit":{"state":"translated","value":"내역 상세"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"流水详情"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"流水詳情"}}}},
    "Expense" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"支出"}},"ko":{"stringUnit":{"state":"translated","value":"지출"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"支出"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"支出"}}}},
    "Expense Projects" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"支出項目ランキング"}},"ko":{"stringUnit":{"state":"translated","value":"지출 프로젝트 순위"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"支出项目排行"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"支出項目排行"}}}},
    "Export Backup" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"バックアップを書き出す"}},"ko":{"stringUnit":{"state":"translated","value":"백업 내보내기"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出备份"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"匯出備份"}}}},
    "Export Current Ledger First" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"先に現在の帳簿を書き出す"}},"ko":{"stringUnit":{"state":"translated","value":"현재 장부 먼저 내보내기"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"先导出当前账本"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"先匯出目前帳本"}}}},
    "Export failed. Choose another location or try again." : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"書き出せませんでした。別の場所を選ぶか、もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"내보내지 못했습니다. 다른 위치를 선택하거나 다시 시도하세요."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出失败，请更换位置或重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"匯出失敗，請更換位置或再試一次。"}}}},
    "Exported" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"書き出し日時"}},"ko":{"stringUnit":{"state":"translated","value":"내보낸 시간"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备份时间"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"備份時間"}}}},
    "Generating image…" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"画像を生成中…"}},"ko":{"stringUnit":{"state":"translated","value":"이미지 생성 중…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在生成图片…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在產生圖片…"}}}},
    "Image generation failed. Try again." : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"画像を生成できませんでした。もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"이미지 생성에 실패했습니다. 다시 시도하세요."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"图片生成失败，请重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"圖片產生失敗，請再試一次。"}}}},
    "Income" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"収入"}},"ko":{"stringUnit":{"state":"translated","value":"수입"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收入"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"收入"}}}},
    "Income Projects" : {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"収入項目ランキング"}},"ko":{"stringUnit":{"state":"translated","value":"수입 프로젝트 순위"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收入项目排行"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"收入項目排行"}}}},
