    "Could not save. Your changes are still here; try again." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern fehlgeschlagen. Deine Änderungen sind noch vorhanden; versuche es erneut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存できませんでした。変更は保持されています。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하지 못했습니다. 변경 내용은 유지됩니다. 다시 시도하세요."
